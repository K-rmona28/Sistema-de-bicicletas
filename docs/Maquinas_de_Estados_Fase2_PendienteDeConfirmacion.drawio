        <mxCell id="n24" edge="1" parent="1" source="n19" style="edgeStyle=none;rounded=1;html=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.6;fontSize=11;fontColor=#1F2A44;labelBackgroundColor=#FFFFFF;" target="n20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n25" edge="1" parent="1" source="n20" style="edgeStyle=none;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.6;fontSize=11;fontColor=#1F2A44;labelBackgroundColor=#FFFFFF;" target="n21" value="sí">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n26" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#4A5568;spacing=2;" value="Cada rectángulo es una &lt;b&gt;acción&lt;/b&gt;; el rombo es una &lt;b&gt;decisión&lt;/b&gt;. Importa el orden de los pasos, no el estado del objeto." vertex="1">
          <mxGeometry height="60" width="700" x="850" y="370" as="geometry" />
        </mxCell>
        <mxCell id="n27" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F1FB;strokeColor=#B5D4F4;strokeWidth=1;fontSize=16;fontColor=#1F2A44;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;&lt;font color=&quot;#0F6E56&quot;&gt;Estado&lt;/font&gt; = cómo cambia un objeto&lt;/b&gt;" vertex="1">
          <mxGeometry height="64" width="740" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F7F1;strokeColor=#A8E0CB;strokeWidth=1;fontSize=16;fontColor=#1F2A44;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;&lt;font color=&quot;#0F6E56&quot;&gt;Actividad&lt;/font&gt; = cómo se ejecuta un proceso&lt;/b&gt;" vertex="1">
          <mxGeometry height="64" width="740" x="820" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n29" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F3864&quot;&gt;¿Cómo decidir qué usar con cada regla de negocio?&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="1520" x="40" y="575" as="geometry" />
        </mxCell>
        <mxCell id="n30" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:12px;border-color:#B5D4F4&quot;&gt;&lt;tr style=&quot;background:#DDEBF7&quot;&gt;&lt;th align=&quot;left&quot;&gt;Si la regla de negocio…&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Se modela con…&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Ejemplos en CycleOn&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;La regla describe &lt;b&gt;etapas de vida&lt;/b&gt; de algo (estados, plazos, bloqueos)&lt;/td&gt;&lt;td&gt;&lt;b&gt;Máquina de estados&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RN-05, RN-06, RN-07, RN-028, RN-029, RN-030&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;La regla describe &lt;b&gt;pasos y decisiones&lt;/b&gt; de un proceso o un cálculo&lt;/td&gt;&lt;td&gt;&lt;b&gt;Diagrama de actividades&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RN-010 (cálculo del pago), RN-019 (traslado entre sedes)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;La regla es una &lt;b&gt;condición o permiso&lt;/b&gt; que habilita o impide un cambio&lt;/td&gt;&lt;td&gt;&lt;b&gt;Guarda  [ ]  en una transición&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RN-01, RN-03, RN-015, RN-017, RN-024&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;La regla exige &lt;b&gt;dejar constancia&lt;/b&gt; o ocultar información&lt;/td&gt;&lt;td&gt;&lt;b&gt;Efecto  /  en una transición&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RN-04, RN-09, RN-013&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="230" width="1520" x="40" y="615" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="737" y="297" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg6" name="01a · Matriz RN-01 a RN-015">
    <mxGraphModel dx="1226" dy="607" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontColor=#1F2A44;spacing=2;" value="&lt;font color=&quot;#1F3864&quot;&gt;&lt;b&gt;Matriz de reglas de negocio&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#0F6E56&quot;&gt;&lt;b&gt;→ máquinas de estados&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="1520" x="40" y="14" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#4A5568;spacing=2;" value="¿Cada regla necesita una máquina de estados, una guarda, un efecto o un diagrama de actividades?" vertex="1">
          <mxGeometry height="26" width="1520" x="40" y="72" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-size: 11px; border-color: rgb(181, 212, 244);&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background: rgb(221, 235, 247);&quot;&gt;&lt;th width=&quot;55&quot; align=&quot;left&quot;&gt;RN&lt;/th&gt;&lt;th width=&quot;400&quot; align=&quot;left&quot;&gt;Regla (resumen)&lt;/th&gt;&lt;th width=&quot;150&quot; align=&quot;left&quot;&gt;Naturaleza&lt;/th&gt;&lt;th width=&quot;85&quot; align=&quot;left&quot;&gt;¿Máquina?&lt;/th&gt;&lt;th width=&quot;200&quot; align=&quot;left&quot;&gt;Dónde se modela&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Cómo aparece (estado, evento, guarda, efecto)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Un administrador puede ejercer el rol de cliente; un cliente no puede ejecutar funciones de administrador.&lt;/td&gt;&lt;td&gt;Restricción de rol&lt;/td&gt;&lt;td style=&quot;background: rgb(243, 244, 246);&quot; align=&quot;center&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Guarda en M1 y M10&lt;/td&gt;&lt;td&gt;Guarda [actor = Global] / [rol = cliente]; no tiene ciclo de vida propio.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;3 intentos de pago dentro de un límite de tiempo fijado por el administrador, hasta confirmar el pago con factura.&lt;/td&gt;&lt;td&gt;Ciclo de vida + temporizada&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M7 Pago&lt;/td&gt;&lt;td&gt;Pendiente ⇄ En proceso; after(límiteDeTiempo) → Expirado; guarda intentos &amp;lt; 3.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Un cliente realiza el préstamo de una sola bicicleta por reserva.&lt;/td&gt;&lt;td&gt;Restricción de cardinalidad&lt;/td&gt;&lt;td style=&quot;background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;&quot; align=&quot;center&quot;&gt;&lt;b style=&quot;background-color: rgb(205, 239, 226);&quot;&gt;Si&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Guarda en M4 y M3&lt;/td&gt;&lt;td&gt;Guarda de iniciarPréstamo() y retirarBicicleta().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Las notificaciones solo las ve el usuario y el administrador que las gestiona.&lt;/td&gt;&lt;td&gt;Visibilidad / acceso&lt;/td&gt;&lt;td style=&quot;background: rgb(243, 244, 246);&quot; align=&quot;center&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Control de acceso&lt;/td&gt;&lt;td&gt;No cambia estados; es una regla de visibilidad del canal de notificaciones.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Todo usuario debe estar verificado, registrado y autenticado antes de cualquier acción.&lt;/td&gt;&lt;td&gt;Ciclo de vida&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1 Cuenta de usuario&lt;/td&gt;&lt;td&gt;Registrada → Activa por verificarCuenta(); guarda de sesión autenticada.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Si no devuelve la bicicleta antes del tiempo final, recibe una sanción económica.&lt;/td&gt;&lt;td&gt;Temporizada + efecto&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3 Préstamo; M2 Sanción&lt;/td&gt;&lt;td&gt;after(duraciónSolicitada) → Vencido; efecto aplicarSanciónEconómica().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-07&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Daño o hurto: bloqueo de 1 mes; nueva sanción grave en 11 meses: bloqueo permanente.&lt;/td&gt;&lt;td&gt;Ciclo de vida + temporizada&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M1 Cuenta; M2 Sanción&lt;/td&gt;&lt;td&gt;Suspendida → En observación (after 1 mes) → Activa (after 11 meses) | Bloqueada permanente.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;La sanción se marca con fecha, hora, descripción, estado e id del usuario.&lt;/td&gt;&lt;td&gt;Datos + ciclo de vida&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2 Sanción&lt;/td&gt;&lt;td&gt;Estado Activa → Cumplida | Revocada; efecto registrarSanción(...).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-09&lt;/b&gt;&lt;/td&gt;&lt;td&gt;La auditoría preserva información de cada usuario; es inmutable y solo la ve el administrador.&lt;/td&gt;&lt;td&gt;Restricción de datos&lt;/td&gt;&lt;td style=&quot;background: rgb(243, 244, 246);&quot; align=&quot;center&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Efecto en todas&lt;/td&gt;&lt;td&gt;Efecto / registrarAuditoría(); un registro inmutable tiene un único estado.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-010&lt;/b&gt;&lt;/td&gt;&lt;td&gt;El pago = tarifa actual × horas + precio de la bicicleta + sanciones.&lt;/td&gt;&lt;td&gt;Cálculo&lt;/td&gt;&lt;td style=&quot;background: rgb(243, 244, 246);&quot; align=&quot;center&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Diagrama de actividades&lt;/td&gt;&lt;td&gt;Es un cálculo paso a paso; en M7 solo aparece como guarda &quot;monto calculado&quot;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-011&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Las tarifas solo las modifica el administrador.&lt;/td&gt;&lt;td&gt;Permiso + ciclo de vida&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M9 Tarifa&lt;/td&gt;&lt;td&gt;Programada → Vigente → Histórica; guarda de permiso en crearTarifa().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-012&lt;/b&gt;&lt;/td&gt;&lt;td&gt;El administrador sigue los préstamos con estado distinto de cancelado y finalizado.&lt;/td&gt;&lt;td&gt;Consulta sobre estados&lt;/td&gt;&lt;td style=&quot;background: rgb(255, 241, 204);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3 Préstamo&lt;/td&gt;&lt;td&gt;Define los estados terminales de M3 (Cancelado, Finalizado).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-013&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Todos los movimientos del usuario se registran en una base de datos auditable.&lt;/td&gt;&lt;td&gt;Auditoría&lt;/td&gt;&lt;td style=&quot;background: rgb(243, 244, 246);&quot; align=&quot;center&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Efecto en todas&lt;/td&gt;&lt;td&gt;Efecto / registrarAuditoría() en las transiciones relevantes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-014&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cada reserva tiene permitido un solo préstamo de bicicleta.&lt;/td&gt;&lt;td&gt;Restricción de cardinalidad&lt;/td&gt;&lt;td style=&quot;background: rgb(255, 241, 204);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M4 Reserva; M3&lt;/td&gt;&lt;td&gt;Vigente → Utilizada ocurre una sola vez.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-015&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Todo préstamo sale de una estación y termina en otra (puede ser la misma).&lt;/td&gt;&lt;td&gt;Restricción de datos&lt;/td&gt;&lt;td style=&quot;background: rgb(243, 244, 246);&quot; align=&quot;center&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Guarda en M3&lt;/td&gt;&lt;td&gt;Guarda de devolver(): estación destino definida.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="465" width="1520" x="40" y="115" as="geometry" />
        </mxCell>
        <mxCell id="IkzWQYxW3HV04ij83pTS-1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-size: 11px; border-color: rgb(181, 212, 244);&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN- 016&lt;br&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Todo préstamo aprobado y finalizado debe pagarse.&lt;/td&gt;&lt;td&gt;Colaboración entre ciclos&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3 → M7&lt;/td&gt;&lt;td&gt;Efecto iniciarCobro() en Finalizado; M7 nace con finalizarPréstamo().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-017&lt;/b&gt;&lt;/td&gt;&lt;td&gt;En la reserva, el punto de inicio y el final es una estación (puede ser la misma).&lt;/td&gt;&lt;td&gt;Restricción de datos&lt;/td&gt;&lt;td style=&quot;background: rgb(243, 244, 246);&quot; align=&quot;center&quot;&gt;&lt;b&gt;No&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Guarda en M4&lt;/td&gt;&lt;td&gt;Guarda de crearReserva().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-018&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cada estación informa las bicicletas disponibles al cliente.&lt;/td&gt;&lt;td&gt;Consulta / visibilidad&lt;/td&gt;&lt;td style=&quot;background: rgb(255, 241, 204);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M6 Estación; M5&lt;/td&gt;&lt;td&gt;Inventario como transición interna en Operativa; estado Disponible en M5.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-019&lt;/b&gt;&lt;/td&gt;&lt;td&gt;El administrador puede trasladar bicicletas entre sedes si la demanda lo requiere.&lt;/td&gt;&lt;td&gt;Proceso con efecto&lt;/td&gt;&lt;td style=&quot;background: rgb(255, 241, 204);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M5 Bicicleta + actividades&lt;/td&gt;&lt;td&gt;Transición interna trasladar(destino) [destino no Saturada]; el flujo completo va en un diagrama de actividades.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-020&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Una bicicleta que necesita mantenimiento adopta un estado especial visible solo para el administrador.&lt;/td&gt;&lt;td&gt;Ciclo de vida&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M5 Bicicleta&lt;/td&gt;&lt;td&gt;Estado En mantenimiento; efecto ocultarAlCliente().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-021&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Una bicicleta no puede estar asociada a más de un cliente al mismo tiempo.&lt;/td&gt;&lt;td&gt;Restricción&lt;/td&gt;&lt;td style=&quot;background: rgb(255, 241, 204);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M5 Bicicleta&lt;/td&gt;&lt;td&gt;Guarda [sin cliente asociado] en reservar().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-022&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Las evidencias de un reporte son inmutables una vez se suben.&lt;/td&gt;&lt;td&gt;Restricción + ciclo del reporte&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M8 Reporte&lt;/td&gt;&lt;td&gt;Transición interna adjuntarEvidencia(); modificarEvidencia() / rechazarOperación().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-023&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Hay dos tipos de administrador: Global (raíz) y Subordinado (con permisos que el Global asigna).&lt;/td&gt;&lt;td&gt;Clasificación de roles&lt;/td&gt;&lt;td style=&quot;background: rgb(255, 241, 204);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M10 Admin subordinado&lt;/td&gt;&lt;td&gt;Contexto de la máquina M10 (el Global es quien dispara los eventos).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-024&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Solo el Administrador Global gestiona cuentas de administrador.&lt;/td&gt;&lt;td&gt;Guarda + ciclo de vida&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M10 Admin subordinado&lt;/td&gt;&lt;td&gt;Guarda [actor = Global] en crear, modificar y eliminar cuenta.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-025&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Un subordinado solo ejecuta funciones con permiso explícito.&lt;/td&gt;&lt;td&gt;Guarda + ciclo de permisos&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M10 Admin subordinado&lt;/td&gt;&lt;td&gt;Sin permisos ⇄ Con permisos; asignarPermiso() / retirarPermiso().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-026&lt;/b&gt;&lt;/td&gt;&lt;td&gt;El administrador con permiso accede a información personal de cualquier usuario.&lt;/td&gt;&lt;td&gt;Guarda&lt;/td&gt;&lt;td style=&quot;background: rgb(255, 241, 204);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Parcial&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M10 Admin subordinado&lt;/td&gt;&lt;td&gt;Transición interna consultarDatosPersonales() [permiso habilitado] / auditarAcceso().&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-027&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Un cliente solo tiene una bicicleta en préstamo Activo; no inicia otro préstamo ni reserva hasta que finalice, se cancele o venza.&lt;/td&gt;&lt;td&gt;Restricción + estados&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3 Préstamo; M4 Reserva&lt;/td&gt;&lt;td&gt;Guarda [sin préstamo Activo]; estados Activo, Finalizado, Cancelado y Vencido.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-028&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Una estación que alcanza su capacidad máxima pasa a Saturada y no recibe devoluciones ni redistribuciones.&lt;/td&gt;&lt;td&gt;Ciclo de vida&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M6 Estación&lt;/td&gt;&lt;td&gt;Operativa → Saturada [disponibles + 1 == capacidad]; guarda en M5.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-029&lt;/b&gt;&lt;/td&gt;&lt;td&gt;El tiempo final del préstamo = duración solicitada + hora de inicio real.&lt;/td&gt;&lt;td&gt;Temporizada&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M3 Préstamo; M4&lt;/td&gt;&lt;td&gt;after(duraciónSolicitada) desde la entrada a Activo; la duración se captura en la reserva.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-030&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Los intentos de pago fallidos se registran y limitan; superado el máximo se bloquea temporalmente un nuevo pago.&lt;/td&gt;&lt;td&gt;Ciclo de vida + temporizada&lt;/td&gt;&lt;td style=&quot;background: rgb(205, 239, 226);&quot; align=&quot;center&quot;&gt;&lt;b&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M7 Pago&lt;/td&gt;&lt;td&gt;En proceso → Bloqueado [intentos == 3]; after(tiempoBloqueo) → Pendiente.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;RN-031&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, serif;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;font-family: Helvetica;&quot;&gt;La revocación manual de una sanción por parte del administrador Revocará la Sanción y restablecerá la cuenta del usuario&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Restricción&amp;nbsp;&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;text-align: -webkit-center;&quot;&gt;Sí&lt;/b&gt;&lt;/td&gt;&lt;td&gt;M2 Sanción&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;text-align: center; white-space: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;revocarSanción()&lt;/span&gt;&lt;br style=&quot;text-align: center; white-space: nowrap;&quot;&gt;&lt;span style=&quot;text-align: center; white-space: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;[permiso de administrador ∧&lt;/span&gt;&lt;br style=&quot;text-align: center; white-space: nowrap;&quot;&gt;&lt;span style=&quot;text-align: center; white-space: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;motivo registrado]&lt;/span&gt;&lt;br style=&quot;text-align: center; white-space: nowrap;&quot;&gt;&lt;span style=&quot;text-align: center; white-space: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;/ registrarAuditoría()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="465" width="1520" x="30" y="580" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg8" name="M1 · Cuenta de usuario">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1F3864;spacing=2;" value="&lt;b&gt;M1 · Máquina de estados — Cuenta de usuario (cliente)&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1560" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6B7A;spacing=2;" value="Máquina de estados UML · Fase 1 (estados simples) · negocio de renta de bicicletas CycleOn" vertex="1">
          <mxGeometry height="20" width="1560" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F8FE;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Entidad modelada&lt;/b&gt;&lt;br&gt;Cuenta del cliente final del servicio de bicicletas (UML: Usuario/Cliente, atributos Estado, IntentosFallidos).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;Registrada → Activa → (Bloqueada por intentos | Suspendida por sanción → En observación → Activa | Bloqueada permanente) → Eliminada.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas que gobiernan su comportamiento&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;RN-05&lt;/b&gt;: todo usuario debe estar verificado, registrado y autenticado antes de realizar cualquier otra acción.&lt;br&gt;2. &lt;b&gt;RN-07&lt;/b&gt;: daño, modificación indebida o hurto bloquean la cuenta 1 mes; una nueva sanción grave en los 11 meses siguientes la bloquea de forma permanente.&lt;br&gt;3. &lt;b&gt;RN-08&lt;/b&gt;: toda sanción queda marcada con fecha, hora, descripción, estado e id del usuario (efecto de las transiciones de bloqueo).&lt;br&gt;4. &lt;b&gt;RN-01&lt;/b&gt;: un administrador puede ejercer el rol de cliente, pero un cliente no puede ejecutar funciones de administrador (guarda por rol).&lt;br&gt;5. &lt;b&gt;RU-28&lt;/b&gt;: 3 intentos fallidos de autenticación bloquean temporalmente el acceso.&lt;br&gt;6. &lt;b&gt;RU-30 / RU-10&lt;/b&gt;: no se duplican documento ni correo; deben aceptarse términos y política de datos antes de completar el registro.&lt;br&gt;7. &lt;b&gt;RN-09 / RN-013&lt;/b&gt;: cada cambio de estado se registra en la auditoría inmutable (efecto / registrarAuditoría()).&lt;br&gt;&lt;br&gt;&lt;b&gt;Supuestos a validar&lt;/b&gt;&lt;br&gt;• Duración del bloqueo por intentos fallidos (RU-28 no la fija): se parametriza como tiempoBloqueo.&lt;br&gt;• &quot;Siguientes 11 meses&quot; se interpreta como una ventana de observación que empieza al terminar el bloqueo de 1 mes.&lt;br&gt;• La revocación de una sanción (UML: RevocarSancion) no reactiva la cuenta en este modelo: ninguna RN lo establece." vertex="1">
          <mxGeometry height="551" width="420" x="20" y="76" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="22" width="22" x="599" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="swimlane;fontStyle=1;fontSize=13;rounded=1;arcSize=7;startSize=30;html=1;whiteSpace=wrap;fillColor=#BBD7F3;swimlaneFillColor=#F3F8FE;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F3864;collapsible=0;" value="Registrada" vertex="1">
          <mxGeometry height="89" width="240" x="490" y="170" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="n6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / enviarVerificación()&lt;br&gt;&lt;b&gt;do&lt;/b&gt; / esperarVerificación()&lt;br&gt;&lt;b&gt;exit&lt;/b&gt; / registrarAuditoría()" vertex="1">
          <mxGeometry height="59" width="240" y="30" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="swimlane;fontStyle=1;fontSize=13;rounded=1;arcSize=7;startSize=30;html=1;whiteSpace=wrap;fillColor=#A8E0CB;swimlaneFillColor=#F0FAF6;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F3864;collapsible=0;" value="Activa" vertex="1">
          <mxGeometry height="159" width="240" x="915" y="170" as="geometry" />
