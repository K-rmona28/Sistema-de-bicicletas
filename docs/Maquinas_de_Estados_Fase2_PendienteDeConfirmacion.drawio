  <diagram id="pg11" name="M4 · Reserva">
    <mxGraphModel dx="1598" dy="886" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1F3864;spacing=2;" value="&lt;b&gt;M4 · Máquina de estados — Reserva de bicicleta&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1560" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6B7A;spacing=2;" value="Máquina de estados UML · Fase 1 (estados simples) · negocio de renta de bicicletas CycleOn" vertex="1">
          <mxGeometry height="20" width="1560" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F8FE;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Entidad modelada&lt;/b&gt;&lt;br&gt;Reserva de una bicicleta en una estación por una duración solicitada (UML: Reserva con Estado, FechaHoraReserva).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;Vigente → Utilizada | Cancelada | Expirada.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas que gobiernan su comportamiento&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;RN-03 / RN-014&lt;/b&gt;: una reserva da lugar a un solo préstamo de una sola bicicleta (Vigente → Utilizada ocurre una vez).&lt;br&gt;2. &lt;b&gt;RN-027&lt;/b&gt;: no se crea una reserva mientras el cliente tenga un préstamo Activo.&lt;br&gt;3. &lt;b&gt;RN-017&lt;/b&gt;: el punto de inicio y el punto final de la reserva es una estación (puede ser la misma).&lt;br&gt;4. &lt;b&gt;RN-029&lt;/b&gt;: la duración solicitada se captura al reservar y fija el tiempo final del préstamo.&lt;br&gt;5. &lt;b&gt;RN-05 / RN-021&lt;/b&gt;: solo usuarios autenticados reservan, y una bicicleta no queda asociada a más de un cliente.&lt;br&gt;6. &lt;b&gt;RF reserva&lt;/b&gt;: se valida que el usuario no tenga reportes ni sanciones activos antes de generar la reserva.&lt;br&gt;7. &lt;b&gt;RN-030 / RU-13&lt;/b&gt;: los intentos de pago fallidos se registran sobre la reserva o el préstamo (se detalla en M7).&lt;br&gt;&lt;br&gt;&lt;b&gt;Supuestos a validar&lt;/b&gt;&lt;br&gt;• Existe un tiempo límite de reserva configurable por el Administrador Global (RF parámetros globales); aquí es tiempoLímiteReserva.&lt;br&gt;• El cálculo de costo estimado antes de confirmar (RU-06) no cambia el estado: se modela como transición interna." vertex="1">
          <mxGeometry height="458" width="420" x="20" y="76" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
