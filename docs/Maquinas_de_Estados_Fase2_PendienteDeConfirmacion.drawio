        <mxCell id="n9" parent="n8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / habilitarAcceso()&lt;br&gt;&lt;b&gt;do&lt;/b&gt; / permitirOperaciones()&lt;br&gt;&lt;b&gt;exit&lt;/b&gt; / cerrarSesiones()&lt;hr size=&quot;1&quot; style=&quot;margin:2px 0&quot;&gt;↻ autenticar() [credencialesVálidas] / abrirSesión()&lt;br&gt;↻ autenticar() [!credencialesVálidas ∧ intentos &amp;lt; 3] / intentos++" vertex="1">
