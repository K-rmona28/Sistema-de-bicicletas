        <mxCell id="n21" edge="1" parent="1" source="n6" style="edgeStyle=none;rounded=1;html=1;exitX=1.0000;exitY=0.5056;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2830;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.6;fontSize=11;fontColor=#1F2A44;labelBackgroundColor=#FFFFFF;" target="n8" value="verificarCuenta()&lt;br&gt;[enlace vigente]&lt;br&gt;/ activarCuenta()">
