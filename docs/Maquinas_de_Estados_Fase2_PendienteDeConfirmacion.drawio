        <mxCell id="n15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E8;strokeWidth=1;fontSize=10;fontColor=#1F2A44;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Simbología:&lt;/b&gt; ● estado inicial · ◉ estado final · ─▶ transición externa  &lt;i&gt;evento [guarda] / efecto&lt;/i&gt; · ╌▶ ⏱ transición temporizada  &lt;i&gt;after(t) / at(fecha)&lt;/i&gt; · ↻ transición interna (no ejecuta exit ni entry) · &lt;b&gt;entry / do / exit&lt;/b&gt; comportamientos del estado" vertex="1">
          <mxGeometry height="40" width="1090" x="490" y="470" as="geometry" />
        </mxCell>
        <mxCell id="F2_NOTE" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#A8E0CB;strokeWidth=1;fontSize=10;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=5;" value="&lt;b&gt;F2 · Junction&lt;/b&gt;&lt;br&gt;Se separan los dos desencadenantes que la Fase 1 ya agrupa en una misma transición: &lt;i&gt;at(vigenciaFin)&lt;/i&gt; y &lt;i&gt;tarifaReemplazada()&lt;/i&gt;. Ambos convergen en Junction y continúan por una única transición común con el efecto &lt;i&gt;archivarTarifa()&lt;/i&gt; hacia Histórica. No se agrega una regla de negocio nueva; se hace explícita la convergencia.&lt;br&gt;&lt;br&gt;&lt;b&gt;Base:&lt;/b&gt; transición original M9 n14; ciclo de vida Programada → Vigente → Histórica; RF de conservación del historial y RN-011." vertex="1">
          <mxGeometry height="160" width="420" x="20" y="530" as="geometry" />
        </mxCell>
