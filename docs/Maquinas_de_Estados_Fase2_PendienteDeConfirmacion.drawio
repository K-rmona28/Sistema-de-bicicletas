        <mxCell id="n28" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D6E8;strokeWidth=1;fontSize=10;fontColor=#1F2A44;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Simbología:&lt;/b&gt; ● estado inicial · ◉ estado final · ─▶ transición externa  &lt;i&gt;evento [guarda] / efecto&lt;/i&gt; · ╌▶ ⏱ transición temporizada  &lt;i&gt;after(t) / at(fecha)&lt;/i&gt; · ↻ transición interna (no ejecuta exit ni entry) · &lt;b&gt;entry / do / exit&lt;/b&gt; comportamientos del estado" vertex="1">
          <mxGeometry height="40" width="1090" x="490" y="880" as="geometry" />
        </mxCell>
        <mxCell id="F2_NOTE" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F6F3;strokeColor=#A8E0CB;strokeWidth=1;fontSize=10;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=5;" value="&lt;b&gt;F2 · Choice&lt;/b&gt;&lt;br&gt;La transición &lt;i&gt;devolver()&lt;/i&gt; solo alcanza el Choice cuando la estación destino no está saturada (RN-028). El Choice selecciona exactamente una ruta: &lt;i&gt;[sin daños]&lt;/i&gt; → Disponible o &lt;i&gt;[daño reportado o detectado]&lt;/i&gt; → En mantenimiento. Las guardas son mutuamente excluyentes. Si la estación está saturada, la precondición impide aceptar la devolución y la bicicleta permanece En préstamo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Base:&lt;/b&gt; transiciones originales M5 n20–n21 + RN-028." vertex="1">
          <mxGeometry height="145" width="420" x="20" y="600" as="geometry" />
        </mxCell>
        <mxCell id="F2_CHOICE_M5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D6F2EA;strokeColor=#1F3864;strokeWidth=2;fontSize=11;fontColor=#1F2A44;align=center;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="68" width="68" x="1010" y="285" as="geometry" />
        </mxCell>
        <mxCell id="F2_CHOICE_M5_LABEL" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#1F3864;" value="«choice»" vertex="1">
          <mxGeometry height="22" width="108" x="990" y="308" as="geometry" />
