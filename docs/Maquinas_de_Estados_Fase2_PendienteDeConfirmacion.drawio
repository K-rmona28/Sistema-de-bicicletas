        </mxCell>
        <mxCell id="n14" edge="1" parent="1" source="n5" style="edgeStyle=none;rounded=1;html=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.6;fontSize=11;fontColor=#1F2A44;labelBackgroundColor=#FFFFFF;" target="n6" value="crearReserva()&lt;br&gt;[clienteAutenticado.estado == Activo ∧ sin préstamo&lt;br&gt;Activo ∧ sin sanciones ni&lt;br&gt;reportes ∧ bicicleta Disponible]&lt;br&gt;/ registrarReserva(estación,&lt;br&gt;duración)">
