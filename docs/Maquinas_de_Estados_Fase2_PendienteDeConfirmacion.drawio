        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1F3864;spacing=2;" value="&lt;b&gt;F2-04 · M9 Máquina de estados — Tarifa (Junction)&lt;/b&gt;" vertex="1">
