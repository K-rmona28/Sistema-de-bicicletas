        </mxCell>
        <mxCell id="gJHpBjhr1HNZQHcbKPAH-33" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;strokeWidth=1.5;fontSize=29;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;fontStyle=1;" value="&lt;b&gt;CYCLEON  |  MATRIZ DE JUSTIFICACIÓN · FASE 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Selección fundamentada de Choice, Junction, Fork y Join para las 11 máquinas de estados&lt;/font&gt;" vertex="1">
          <mxGeometry height="145" width="2690" x="55" y="35" as="geometry" />
        </mxCell>
        <mxCell id="gJHpBjhr1HNZQHcbKPAH-34" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F8FE;strokeColor=#BBD7F3;strokeWidth=1.2;fontSize=17;fontColor=#1F2A44;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;" value="&lt;b&gt;Propósito:&lt;/b&gt; decidir dónde cada pseudoestado aporta significado real al comportamiento de CycleOn. No se añaden símbolos para cumplir una cuota: cada uso debe estar respaldado por una decisión, convergencia o concurrencia documentada." vertex="1">
