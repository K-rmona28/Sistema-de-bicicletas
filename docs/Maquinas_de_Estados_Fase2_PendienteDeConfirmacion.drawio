        <mxCell id="n16" edge="1" parent="1" source="n8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=11;fontColor=#1F2A44;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.45;entryX=0;entryY=0.50;" target="F2_JUNCTION_M10" value="eliminarCuenta()&lt;br&gt;[actor = Global]" vertex="0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="295" />
