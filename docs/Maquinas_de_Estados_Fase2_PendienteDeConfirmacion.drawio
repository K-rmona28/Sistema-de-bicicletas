          <mxGeometry height="129" width="240" x="915" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="n8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / aplicarValorHora()&lt;br&gt;&lt;b&gt;do&lt;/b&gt; / calcularCobros()&lt;br&gt;&lt;b&gt;exit&lt;/b&gt; / cerrarVigencia()&lt;hr size=&quot;1&quot; style=&quot;margin:2px 0&quot;&gt;↻ consultarTarifa() / mostrarValorHora()" vertex="1">
          <mxGeometry height="99" width="240" y="30" as="geometry" />
