erencia de cobro" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1678" y="761" as="sourcePoint"/><mxPoint x="1506" y="761" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_15" value="referencia" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1506" y="799" as="sourcePoint"/><mxPoint x="646" y="799" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_16" value="PagoDto (Pendiente)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="837" as="sourcePoint"/><mxPoint x="474" y="837" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_17" value="201 Created (PagoDto)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="474" y="875" as="sourcePoint"/><mxPoint x="302" y="875" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_18" value="Ingresar datos de pago en la pasarela" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="913" as="sourcePoint"/><mxPoint x="1678" y="913" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_19" value="POST /api/webhooks/pagos (resultado + firma)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1678" y="951" as="sourcePoint"/><mxPoint x="1850" y="951" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_20" value="ConfirmarPagoAsync(dto, firma)" style="html=1