Id)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="925" as="sourcePoint"/><mxPoint x="890" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_20" value="Prestamo vencido" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="963" as="sourcePoint"/><mxPoint x="1460" y="963" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_21" value="AplicarAsync(usuarioId, 'Devolución tardía', prestamoId)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1001" as="sourcePoint"/><mxPoint x="1650" y="1001" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_22" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1650" y="1039" as="sourcePoint"/><mxPoint x="1650" y="1063" as="targetPoint"/><Array as="points"><mxPoint x="1688" y="1039"/><mxPoint x="1688" y="1063"/></Array></mxGeometry></mxCell><mxCell id="s4_23" value="Strategy: SancionEconomicaStrategy.Calcular(prestamo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1694" y="1037" width="250" height="28" as="geometry"/></mxCell><mxCell id="s4_24" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1650" y="1081" as="sourcePoint"/><mxPoint x="1650" y="1105" as="targetPoint"/><Array as="points"><mxPoint x="1688" y="1081"/><mxPoint x="1688" y="1105"/></Array></mxGeometry></mxCell><mxCell id="s4_25" value="Registrar sanción (fecha, hora, descripción, estado, usuario)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1694" y="1079" width="250" height="28" as="geometry"/></mxCell><mxCell id="s4_26" value="Sancion aplicada" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1650" y="1123" as="sourcePoint"/><mxPoint x="1460" y="1123" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_27" value="ActualizarAsync(Prestamo estado Vencido)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1161" as="sourcePoint"/><mxPoint x="890" y="1161" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_28" value="NotificarCambioEstadoAsync(prestamoId, 'Vencido')" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="1199" as="sourcePoint"/><mxPoint x="1080" y="1199" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_29" value="Aviso de sanción económica" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="1237" as="sourcePoint"/><mxPoint x="130" y="1237" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_30" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="1303" as="sourcePoint"/><mxPoint x="1270" y="1327" as="targetPoint"/><Array as="points"><mxPoint x="1308" y="1303"/><mxPoint x="1308" y="1327"/></Array></mxGeometry></mxCell><mxCell id="s4_31" value="Descartar trabajo de vencimiento (préstamo ya finalizado)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1314" y="1301" width="250" height="28" as="geometry"/></mxCell><mxCell id="s4_32" value="RN-08: toda sanción se marca con fecha, hora, descripción, estado y id del usuario penalizado." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#999999;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1760" y="1051" width="210" height="70" as="geometry"/></mxCell><mxCell id="s4_43" value="[restante menor al umbral de aviso]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="665" width="644" height="18" as="geometry"/></mxCell><mxCell id="s4_45" value="[cada intervalo mientras el préstamo esté Activo]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="292" y="529" width="660" height="18" as="geometry"/></mxCell><mxCell id="s4_47" value="[tiempo final superado sin devolver (RN-06, RN-29)]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="811" width="1610" height="18" as="geometry"/></mxCell><mxCell id="s4_48" value="[devuelto a tiempo]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="1281" width="1610" height="18" as="geometry"/></mxCell><mxCell id="s4_49" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="1279" as="sourcePoint"/><mxPoint x="1730" y="1279" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4_50" value="&lt;b&gt;Escenario:&lt;/b&gt; Seguimiento en tiempo real del tiempo restante y sanción automática por vencimiento&lt;br&gt;&lt;b&gt;Épica:&lt;/b&gt; 4. Controlar préstamo activo &amp;nbsp;|&amp;nbsp; &lt;b&gt;HU:&lt;/b&gt; HU-08&lt;br&gt;&lt;b&gt;Actor principal:&lt;/b&gt; Usuario&lt;br&gt;&lt;b&gt;Participantes:&lt;/b&gt; Usuario, AplicacionWeb, PrestamoHub (SignalR), PrestamoService, PrestamoRepository, NotificacionService, EjecutorTareas, ManejadorVencimientos, SancionService" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="5" width="1920" height="110" as="geometry"/></mxCell><mxCell id="s4_51" value="&lt;b&gt;Explicación técnica&lt;/b&gt;&lt;br&gt;Al abrir el préstamo activo, la Aplicación Web se suscribe al PrestamoHub por SignalR. El hub pide a PrestamoService el tiempo restante, que lo calcula sobre el préstamo leído del repositorio, y lo publica al cliente; este ciclo se repite mientras el préstamo siga Activo (fragmento loop). Cuando el tiempo restante baja del umbral, un opt envía un aviso al usuario por NotificacionService. En el flujo alternativo, si pasó el tiempo final sin devolución, el EjecutorTareas del Procesador de Tareas toma el trabajo de vencimiento y ManejadorVencimientos pide a SancionService aplicar una sanción económica, calculada con el patrón Strategy (RN-06); el préstamo pasa a Vencido y se notifica al usuario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Coherencia con el diseño (ajustes sugeridos en C4 nivel 4 / actividades)&lt;/b&gt;&lt;br&gt;• EstadoPrestamo necesita el valor Vencido (RN-27); hoy tiene Reservado, Activo, Finalizado y Cancelado.&lt;br&gt;• 'SancionEconomicaStrategy' es un nombre propuesto a partir del diagrama de actividades 2; cámbialo por el que usaron en el Entregable 2.&lt;br&gt;• El umbral de aviso (minutos antes del final) no está definido en las reglas de negocio." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1399" width="1920" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="SEC 5 - Reporte de daños" id="s5"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2062" pageHeight="2179"><roo