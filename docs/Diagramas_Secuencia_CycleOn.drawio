"/></mxGeometry></mxCell><mxCell id="s2_13" value="BicicletaNoDisponibleException" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="723" as="sourcePoint"/><mxPoint x="500" y="723" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_14" value="409 Conflict" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="761" as="sourcePoint"/><mxPoint x="315" y="761" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_15" value="Sugerir elegir otra bicicleta" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="799" as="sourcePoint"/><mxPoint x="130" y="799" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_16" value="CalcularCostoEstimado(minutos)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="865" as="sourcePoint"/><mxPoint x="1055" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_17" value="costo estimado" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="903" as="sourcePoint"/><mxPoint x="685" y="903" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_18" value="AgregarAsync(Prestamo estado Reservado)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="941" as="sourcePoint"/><mxPoint x="1240" y="941" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_1