ll=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="537" as="sourcePoint"/><mxPoint x="530" y="537" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_10" value="409 Conflict" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="575" as="sourcePoint"/><mxPoint x="330" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_11" value="Informar que el correo ya existe" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="613" as="sourcePoint"/><mxPoint x="130" y="613" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_12" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="679" as="sourcePoint"/><mxPoint x="730" y="703" as="targetPoint"/><Array as="points"><mxPoint x="768" y="679"/><mxPoint x="768" y="703"/></Array></mxGeometry></mxCell><mxCell id="s1_13" value="HashearContrasena(contrasena)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="774" y="677" width="250" height="28" as="geometry"/></mxCell><mxCell id="s1_14" value="AgregarAsync(Usuario Activo)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="721" as="sourcePoint"/><mxPoint x="930" y="721" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_15" value="Usuario con Id" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="759" as="sourcePoint"/><mxPoint x="730" y="759" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_16" value="RegistrarAsync('RegistroUsuario','Usuario',id)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="797" as="sourcePoint"/><mxPoint x="1130" y="797" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_17" value="evento inmutable guardado" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="835" as="sourcePoint"/><mxPoint x="730" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_18" value="UsuarioDto" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="873" as="sourcePoint"/><mxPoint x="530" y="873" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_19" value="201 Created (UsuarioDto)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="911" as="sourcePoint"/><mxPoint x="330" y="911" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_20" value="Confirmar registro y permitir inicio de sesión" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="949" as="sourcePoint"/><mxPoint x="130" y="949" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_21" value="RN-09 / RN-13: la auditoría es inmutable y guarda la información de cada usuario registrado." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#999999;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1240" y="787" width="210" height="60" as="geometry"/></mxCell><mxCell id="s1_29" value="[correo ya registrado]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="503" width="1074" height="18" as="geometry"/></mxCell><mxCell id="s1_30" value="[correo disponible]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="657" width="1074" height="18" as="geometry"/></mxCell><mxCell id="s1_31" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="58" y="655" as="sourcePoint"/><mxPoint x="1202" y="655" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_33" value="[formato inválido]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="263" width="1090" height="18" as="geometry"/></mxCell><mxCell id="s1_34" value="[formato válido]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="341" width="1090" height="18" as="geometry"/></mxCell><mxCell id="s1_35" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="339" as="sourcePoint"/><mxPoint x="1210" y="339" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1_36" value="&lt;b&gt;Escenario:&lt;/b&gt; Registro de un nuevo usuario con validación de formato y de correo duplicado&lt;br&gt;&lt;b&gt;Épica:&lt;/b&gt; 1. Acceder al sistema &amp;nbsp;|&amp;nbsp; &lt;b&gt;HU:&lt;/b&gt; HU-01&lt;br&gt;&lt;b&gt;Actor principal:&lt;/b&gt; Usuario (ciudadano interesado en la movilidad activa)&lt;br&gt;&lt;b&gt;Participantes:&lt;/b&gt; Usuario, AplicacionWeb (Angular), UsuarioController, UsuarioService, UsuarioRepository, AuditoriaService" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="5" width="1400" height="110" as="geometry"/></mxCell><mxCell id="s1_37" value="&lt;b&gt;Explicación técnica&lt;/b&gt;&lt;br&gt;La Aplicación Web valida el formato en el cliente y, si es correcto, envía el RegistroUsuarioDto al UsuarioController, que delega en UsuarioService. El servicio consulta el repositorio por correo; si ya existe, lanza una excepción de dominio que el controlador traduce a 409 Conflict (flujo alternativo). Si el correo está disponible, hashea la contraseña, persiste el usuario activo con el repositorio y registra el evento en AuditoriaService, que lo guarda de forma inmutable. El controlador responde 201 Created y la interfaz confirma el registro. La validación de formato con errores es el segundo flujo alternativo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Coherencia con el diseño (ajustes sugeridos en C4 nivel 4 / actividades)&lt;/b&gt;&lt;br&gt;• La verificación del usuario exigida por la RN-05 no está modelada porque no aparece en el nivel 4; si la implementaron, se agrega un paso de envío de correo con NotificacionService.&lt;br&gt;• El diagrama de actividades 0 incluye también el inicio de sesión; aquí se representa solo el registro (HU-01)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1065" width="1400" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="SEC 2 - Reserva de bicicleta" id="s2"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1940" pageHeight="1585"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s2_26" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;«actor»&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#FFF2CC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="62" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_27" value="&lt;b&gt;AplicacionWeb&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Angular · ModuloReserva]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#DAE8FC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="247" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_28" value="&lt;b&gt;PrestamoController&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Controller]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#D5E8D4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="432" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_29" value="&lt;b&gt;PrestamoService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#E1D5E7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="617" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_30" value="&lt;b&gt;SancionService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#E1D5E7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="802" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_31" value="&lt;b&gt;CalculadoraCosto&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#E1D5E7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="987" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_32" value="&lt;b&gt;PrestamoRepository&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Repository]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#F8CECC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1172" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_33" value="&lt;b&gt;BicicletaRepository&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Repository]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#F8CECC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1357" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_34" value="&lt;b&gt;NotificacionService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#E1D5E7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1542" y="125" width="136" height="1140" as="geometry"/></mxCell><mxCell id="s2_35" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=46;height=22;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="687" width="1624" height="530" as="geometry"/></mxCell><mxCell id="s2_39" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=46;height=22;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="447" width="1640" height="794" as="geometry"/></mxCell><mxCell id="s2_1" value="Seleccionar bicicleta, estación y duración (horas)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="195" as="sourcePoint"/><mxPoint x="315" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_2" value="POST /api/prestamos/reservar (SolicitudPrestamoDto)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="233" as="sourcePoint"/><mxPoint x="500" y="233" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_3" value="ReservarAsync(solicitud)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="271" as="sourcePoint"/><mxPoint x="685" y="271" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_4" value="ObtenerActivoPorUsuarioAsync(usuarioId)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="309" as="sourcePoint"/><mxPoint x="1240" y="309" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_5" value="Prestamo? (activo)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="347" as="sourcePoint"/><mxPoint x="685" y="347" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2_6" value="TieneSancionActivaAsync(usuarioId)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y