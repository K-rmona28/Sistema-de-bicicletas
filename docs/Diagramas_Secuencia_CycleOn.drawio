<mxCell id="s3_33" value="GET /api/pagos/{id}/estado" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="302" y="1437" as="sourcePoint"/><mxPoint x="474" y="1437" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_34" value="PagoDto (Confirmado)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="474" y="1475" as="sourcePoint"/><mxPoint x="302" y="1475" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_35" value="Mostrar factura y préstamo finalizado" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="302" y="1513" as="sourcePoint"/><mxPoint x="130" y="1513" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_36" value="ActualizarAsync(Pago Rechazado, intento fallido)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="1579" as="sourcePoint"/><mxPoint x="818" y="1579" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_37" value="RegistrarAsync('PagoRechazado','Pago',id)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="1617" as="sourcePoint"/><mxPoint x="1334" y="1617" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_38" value="Pago procesado" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="646" y="1655" as="sourcePoint"/><mxPoint x="1850" y="1655" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_39" value="200 OK" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="1693" as="sourcePoint"/><mxPoint x="1678" y="1693" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_40" value="GET /api/pagos/{id}/estado" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="302" y="1731" as="sourcePoint"/><mxPoint x="474" y="1731" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_41" value="PagoDto (Rechazado)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="474" y="1769" as="sourcePoint"/><mxPoint x="302" y="1769" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_42" value="Informar rechazo y permitir nuevo intento" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="302" y="1807" as="sourcePoint"/><mxPoint x="130" y="1807" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_55" value="[pago aprobado]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="118" y="1133" width="1778" height="18" as="geometry"/></mxCell><mxCell id="s3_56" value="[pago rechazado]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="1557" width="1778" height="18" as="geometry"/></mxCell><mxCell id="s3_57" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="66" y="1555" as="sourcePoint"/><mxPoint x="1914" y="1555" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_59" value="[3 o más intentos fallidos: pagos bloqueados]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="471" width="1794" height="18" as="geometry"/></mxCell><mxCell id="s3_60" value="[intentos disponibles]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="625" width="1794" height="18" as="geometry"/></mxCell><mxCell id="s3_61" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="58" y="623" as="sourcePoint"/><mxPoint x="1922" y="623" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3_63" value="[hasta pago aprobado o 3 intentos fallidos (RN-02, RN-30)]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="221" width="1810" height="18" as="geometry"/></mxCell><mxCell id="s3_64" value="&lt;b&gt;Escenario:&lt;/b&gt; Pago del préstamo finalizado mediante pasarela externa, con confirmación por webhook firmado y reintentos limitados&lt;br&gt;&lt;b&gt;Épica:&lt;/b&gt; 3. Pagar y registrar préstamo &amp;nbsp;|&amp;nbsp; &lt;b&gt;HU:&lt;/b&gt; HU-18&lt;br&gt;&lt;b&gt;Actor principal:&lt;/b&gt; Usuario&lt;br&gt;&lt;b&gt;Participantes:&lt;/b&gt; Usuario, AplicacionWeb, PagoController, PagoService, PagoRepository, PrestamoRepository, PrestamoService, AuditoriaService, ClientePasarelaPagos, Pasarela de Pagos (externa), WebhookPagosController" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="5" width="2120" height="110" as="geometry"/></mxCell><mxCell id="s3_65" value="&lt;b&gt;Explicación técnica&lt;/b&gt;&lt;br&gt;El PagoController recibe la solicitud y PagoService obtiene el préstamo con su CostoFinal (tarifa, horas, precio y sanciones, RN-10) y consulta los intentos fallidos. Si ya hay tres, lanza PagosBloqueadosException y la interfaz informa el bloqueo temporal (RN-02, RN-30). Si no, crea un Pago pendiente, pide el cobro a la pasarela mediante ClientePasarelaPagos y devuelve la referencia. El usuario paga en la pasarela, que notifica el resultado al WebhookPagosController; PagoService verifica la firma, y si el pago fue aprobado lo confirma, finaliza el préstamo (stock de la estación y bicicleta liberada) y audita el evento. Si fue rechazado, registra el intento fallido y el usuario puede reintentar mientras no supere el máximo (fragmento loop).&lt;br&gt;&lt;br&gt;&lt;b&gt;Coherencia con el diseño (ajustes sugeridos en C4 nivel 4 / actividades)&lt;/b&gt;&lt;br&gt;• IPagoRepository necesita un método para contar intentos fallidos (ObtenerIntentosFallidosAsync).&lt;br&gt;• IPrestamoService necesita FinalizarPrestamoAsync, y PagoService debe depender de IPrestamoService y de IAuditoriaService (en el nivel 4 solo usa IPrestamoRepository).&lt;br&gt;• La duración del bloqueo temporal de pagos no está definida en las reglas de negocio." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1947" width="2120" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="SEC 4 - Préstamo activo" id="s4"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1980" pageHeight="1699"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s4_33" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;«actor»&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#FFF2CC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="62" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_34" value="&lt;b&gt;AplicacionWeb&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Angular · ModuloPrestamoActivo]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#DAE8FC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="252" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_35" value="&lt;b&gt;PrestamoHub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[SignalR Hub]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#D5E8D4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="442" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_36" value="&lt;b&gt;PrestamoService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#E1D5E7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="632" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_37" value="&lt;b&gt;PrestamoRepository&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Repository]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#F8CECC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="822" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_38" value="&lt;b&gt;NotificacionService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#E1D5E7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1012" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_39" value="&lt;b&gt;EjecutorTareas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Worker Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#FFE6CC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1202" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_40" value="&lt;b&gt;ManejadorVencimientos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Task Handler]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#FFE6CC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1392" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_41" value="&lt;b&gt;SancionService&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;[Service]&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=44;fontSize=10;fillColor=#E1D5E7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1582" y="125" width="136" height="1254" as="geometry"/></mxCell><mxCell id="s4_42" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=46;height=22;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="438" y="663" width="714" height="122" as="geometry"/></mxCell><mxCell id="s4_44" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=46;height=22;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="527" width="730" height="282" as="geometry"/></mxCell><mxCell id="s4_46" value="alt" style="shape=