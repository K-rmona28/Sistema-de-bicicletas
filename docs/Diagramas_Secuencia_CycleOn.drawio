1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="842" y="1735" as="sourcePoint"/><mxPoint x="664" y="1735" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5_41" value="200 OK" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="664" y="1773" as="sourcePoint"/><mxPoint x="486" y="1773" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5_42" value="Mostrar resultado de la resolución" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="486" y="1811" as="sourcePoint"/><mxPoint x="308" y="1811" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5_43" value="RN-20: la bicicleta que necesita mantenimiento adopta un estado visible solo para el administrador." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF9C4;strokeColor=#999999;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1842" y="1413" width="210" height="60" as="geometry"/></mxCell><mxCell id="s5_55" value="[el reporte incluye evidencia]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="651" width="1676" height="18" as="geometry"/></mxCell><mxCell id="s5_57" value="[datos inválidos (bicicleta inexistente o descripción vacía)]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="411" width="1692" height="18" as="geometry"/></mxCell><mxCell id="s5_58" value="[datos válidos]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="565" width="1692" height="18" as="geometry"/></mxCell><mxCell id="s5_59" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="563" as="sourcePoint"/><mxPoint x="1812" y="563" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5_61" value="[hay culpa del usuario (RN-07)]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="822" y="1459" width="786" height="18" as="geometry"/></mxCell><mxCell id="s5_63" value="[reporte improcedente]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="1253" width="1514" height="18" as="geometry"/></mxCell><mxCell id="s5_64" value="[reporte procedente]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="234" y="1369" width="1514" height="18" as="geometry"/></mxCell><mxCell id="s5_65" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="228" y="1367" as="sourcePoint"/><mxPoint x="1812" y="1367" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5_66" value="&lt;b&gt;Escenario:&lt;/b&gt; Reporte de un daño con evidencia por el usuario y resolución por el administrador, con sanción si hay culpa&lt;br&gt;&lt;b&gt;Épica:&lt;/b&gt; 5. Consultar actividad y reportar incidencias &amp;nbsp;|&amp;nbsp; &lt;b&gt;HU:&lt;/b&gt; HU-11&lt;br&gt;&lt;b&gt;Actor principal:&lt;/b&gt; Usuario (reporta) y Administrador (resuelve)&lt;br&gt;&lt;b&gt;Participantes:&lt;/b&gt; Usuario, Administrador, AplicacionWeb, ReporteController, ReporteService, ClienteEvidencias, ReporteRepository, BicicletaRepository, SancionService, NotificacionService" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="5" width="2002" height="110" as="geometry"/></mxCell><mxCell id="s5_67" value="&lt;b&gt;Explicación técnica&lt;/b&gt;&lt;br&gt;En la fase 1, el ReporteController delega en ReporteService, que valida que la bicicleta exista; si los datos son inválidos responde 400 (flujo alternativo). Si son válidos, persiste el reporte en estado Abierto y, si hay evidencia (fragmento opt), la guarda mediante ClienteEvidencias, que la deja inmutable (RN-22). En la fase 2, el administrador resuelve el reporte: si es improcedente se cierra y se notifica; si es procedente, se aplica la acción (la bicicleta pasa a EnMantenimiento, RN-20) y, cuando hay culpa del usuario, SancionService bloquea su cuenta un mes, o de forma permanente si reincide en 11 meses (RN-07). Al final se actualiza el reporte y se notifica al usuario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Coherencia con el diseño (ajustes sugeridos en C4 nivel 4 / actividades)&lt;/b&gt;&lt;br&gt;• La orden de mantenimiento (prioridad, fechas, estado) del diagrama de actividades 3 no tiene componente en el nivel 3 (RF-15 sin HU), por eso aquí solo se cambia el estado de la bicicleta.&lt;br&gt;• Si 'hay culpa' lo decide el administrador, ResolverReporteDto debería incluir ese dato.&lt;br&gt;• La política de bloqueo (1 mes, 11 meses) la implementa SancionService; conviene que el nivel 4 de Sanciones lo refleje." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1879" width="2002" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>