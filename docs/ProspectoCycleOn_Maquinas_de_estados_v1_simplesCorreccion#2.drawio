        <mxCell id="n9" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3CCF3;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse: collapse; width: 100%; font-size: 11px; border-color: rgb(211, 204, 243);&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background: rgb(231, 225, 247);&quot;&gt;&lt;th align=&quot;left&quot;&gt;Evento que sale de&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Lo recibe&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M4 retirarBicicleta()&lt;/td&gt;&lt;td&gt;M3 iniciarPréstamo(); M5 retirar()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M4 cancelar / expira&lt;/td&gt;&lt;td&gt;M5 liberar()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M3 devolver()&lt;/td&gt;&lt;td&gt;M5 devolver(); M6 bicicletaDevuelta()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M3 Vencido (entry)&lt;/td&gt;&lt;td&gt;M2 aplicarSanción() (RN-06)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M8 resolver()&lt;/td&gt;&lt;td&gt;M2 aplicarSanción(); M5 ordenMantenimiento()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M2 sanción grave / after(1 mes)&lt;/td&gt;&lt;td&gt;M1 sancionGraveRegistrada() / sancionCumplida()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M3 Finalizado (entry)&lt;/td&gt;&lt;td&gt;M7 finalizarPréstamo() → crea el cobro (RN-016)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M7 pagoConfirmado()&lt;/td&gt;&lt;td&gt;M2 pagoConfirmado() (sanción económica)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M9 Vigente&lt;/td&gt;&lt;td&gt;M7 calcula el monto con la tarifa actual (RN-010)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M10 permisos&lt;/td&gt;&lt;td&gt;guardas &quot;admin con permiso&quot; en M2, M5, M6, M9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;M11 Mantenimiento&lt;/td&gt;&lt;td&gt;M5 ocultarAlCliente() (RN-020); M5 LiberarBicicleta()&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&