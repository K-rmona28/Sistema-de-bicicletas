  <diagram id="pg17" name="M10 · Administrador subordinado">
    <mxGraphModel dx="1772" dy="877" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1F3864;spacing=2;" value="&lt;b&gt;M10 · Máquina de estados — Cuenta de administrador subordinado&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1560" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6B7A;spacing=2;" value="Máquina de estados UML · Fase 1 (estados simples) · negocio de renta de bicicletas CycleOn" vertex="1">
          <mxGeometry height="20" width="1560" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F8FE;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Entidad modelada&lt;/b&gt;&lt;br&gt;Cuenta de un administrador subordinado creada y gestionada por el Administrador Global, con permisos asignables, modificables y revocables.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;Sin permisos ⇄ Con permisos → Eliminada.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas que gobiernan su comportamiento&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;RN-023&lt;/b&gt;: existen dos tipos de administrador: Global (rol raíz) y Subordinado (con los permisos que el Global le asigne).&lt;br&gt;2. &lt;b&gt;RN-024&lt;/b&gt;: solo el Administrador Global crea, modifica o elimina cuentas de administrador; un subordinado no puede, ni siquiera sobre la suya.&lt;br&gt;3. &lt;b&gt;RN-025&lt;/b&gt;: un subordinado solo ejecuta funciones con permiso explícito; lo no autorizado queda oculto o inaccesible.&lt;br&gt;4. &lt;b&gt;RN-026&lt;/b&gt;: el administrador (Global o subordinado con permiso) accede a información personal de usuarios; cada acceso se audita (RNF-22).&lt;br&gt;5. &lt;b&gt;RN-011&lt;/b&gt;: las tarifas solo las modifica el administrador; el permiso puede delegarse al subordinado (RU-29).&lt;br&gt;6. &lt;b&gt;RN-01&lt;/b&gt;: un administrador puede ejercer el rol de cliente, no al revés.&lt;br&gt;7. &lt;b&gt;RU-20 / RU-21&lt;/b&gt;: crear, modificar y eliminar cuentas; asignar, modificar y retirar permisos (cambios auditados, RNF-21).&lt;br&gt;&lt;br&gt;&lt;b&gt;Supuestos a validar&lt;/b&gt;&lt;br&gt;• No se modela suspensión de cuenta: los documentos no la definen.&lt;br&gt;• Los cambios de permisos son transiciones internas: no cambian el estado, solo auditan." vertex="1">
          <mxGeometry height="489" width="420" x="20" y="76" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="22" width="22" x="599" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1445" y="230" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="n6" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="16" width="16" x="7" y="7" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="swimlane;fontStyle=1;fontSize=13;rounded=1;arcSize=7;startSize=30;html=1;whiteSpace=wrap;fillColor=#BBD7F3;swimlaneFillColor=#F3F8FE;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F3864;collapsible=0;" value="Sin permisos" vertex="1">
          <mxGeometry height="190" width="240" x="490" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="n8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / ocultarFunciones()&lt;hr size=&quot;1&quot; style=&quot;margin:2px 0&quot;&gt;↻ gestionarCuentaAdmin() [actor ≠ Global] / rechazarYAuditar()" vertex="1">
          <mxGeometry height="160" width="240" y="30" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="swimlane;fontStyle=1;fontSize=13;rounded=1;arcSize=7;startSize=30;html=1;whiteSpace=wrap;fillColor=#A8E0CB;swimlaneFillColor=#F0FAF6;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F3864;collapsible=0;" value="Con permisos" vertex="1">
          <mxGeometry height="204" width="240" x="915" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="n10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / habilitarFunciones()&lt;br&gt;&lt;b&gt;do&lt;/b&gt; / validarPermisoPorAcción()&lt;hr size=&quot;1&quot; style=&quot;margin:2px 0&quot;&gt;↻ asignarPermiso(p) [actor = Global] / registrarCambioPermisos()&lt;br&gt;↻ modificarPermiso(p) [actor = Global] / registrarCambioPermisos()&lt;br&gt;↻ consultarDatosPersonales() [permiso habilitado] / auditarAcceso()&lt;br&gt;↻ gestionarCuentaAdmin() [actor ≠ Global] / rechazarYAuditar()" vertex="1">
