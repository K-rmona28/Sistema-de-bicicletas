  <diagram id="pg10" name="M3 · Préstamo">
    <mxGraphModel dx="2132" dy="1055" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1F3864;spacing=2;" value="&lt;b&gt;M3 · Máquina de estados — Préstamo de bicicleta&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1560" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6B7A;spacing=2;" value="Máquina de estados UML · Fase 1 (estados simples) · negocio de renta de bicicletas CycleOn" vertex="1">
          <mxGeometry height="20" width="1560" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F8FE;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Entidad modelada&lt;/b&gt;&lt;br&gt;Préstamo de una bicicleta a un cliente, originado por una reserva (UML: Prestamo con Estado, FechaHoraInicio, FechaHoraFin).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;Activo → Finalizado | Vencido → Finalizado | Cancelado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas que gobiernan su comportamiento&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;RN-03 / RN-014&lt;/b&gt;: una sola bicicleta por reserva y un solo préstamo por reserva.&lt;br&gt;2. &lt;b&gt;RN-027&lt;/b&gt;: un cliente solo puede tener un préstamo en estado Activo; no inicia otro préstamo ni reserva hasta que finalice, se cancele o se marque como vencido.&lt;br&gt;3. &lt;b&gt;RN-029&lt;/b&gt;: el tiempo final = duración solicitada en la reserva + hora de inicio real (transición temporizada).&lt;br&gt;4. &lt;b&gt;RN-06&lt;/b&gt;: no devolver antes del tiempo final genera una sanción económica (efecto al pasar a Vencido).&lt;br&gt;5. &lt;b&gt;RN-015&lt;/b&gt;: el préstamo sale de una estación y termina en otra (puede ser la misma).&lt;br&gt;6. &lt;b&gt;RN-016&lt;/b&gt;: todo préstamo aprobado y finalizado debe pagarse (efecto: iniciarCobro() hacia la máquina Pago).&lt;br&gt;7. &lt;b&gt;RN-012 / RN-021&lt;/b&gt;: el administrador da seguimiento a préstamos distintos de Cancelado y Finalizado; una bicicleta no se asocia a más de un cliente.&lt;br&gt;&lt;br&gt;&lt;b&gt;Supuestos a validar&lt;/b&gt;&lt;br&gt;• &quot;Cancelado&quot; solo lo causa un incidente antes de usar la bicicleta o una decisión administrativa (la RN-027 menciona la cancelación pero no su causa).&lt;br&gt;• Un préstamo Vencido se puede devolver después; la sanción de RN-06 ya se aplicó al entrar a Vencido." vertex="1">
          <mxGeometry height="504" width="420" x="20" y="76" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="20" width="20" x="600" y="24" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="swimlane;fontStyle=1;fontSize=13;rounded=1;arcSize=7;startSize=30;html=1;whiteSpace=wrap;fillColor=#A8E0CB;swimlaneFillColor=#F0FAF6;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F3864;collapsible=0;" value="Activo" vertex="1">
