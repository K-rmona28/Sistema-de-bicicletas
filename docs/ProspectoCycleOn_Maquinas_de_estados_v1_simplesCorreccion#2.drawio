  <diagram id="pg15" name="M8 · Reporte">
    <mxGraphModel dx="1471" dy="728" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1F3864;spacing=2;" value="&lt;b&gt;M8 · Máquina de estados — Reporte de daño o pérdida&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1560" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6B7A;spacing=2;" value="Máquina de estados UML · Fase 1 (estados simples) · negocio de renta de bicicletas CycleOn" vertex="1">
          <mxGeometry height="20" width="1560" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F8FE;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Entidad modelada&lt;/b&gt;&lt;br&gt;Reporte de daños, pérdidas, robos o préstamos no legalizados, con sus evidencias (UML: Reporte con Estado; Evidencia compuesta).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;Registrado → En revisión → Resuelto | Descartado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas que gobiernan su comportamiento&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;RN-022&lt;/b&gt;: las evidencias de un reporte son inmutables una vez se suben (adjuntar sí; modificar no genera transición).&lt;br&gt;2. &lt;b&gt;RN-07&lt;/b&gt;: si el usuario resulta culpable de daños, modificación indebida o hurto se aplica una sanción (efecto de resolver()).&lt;br&gt;3. &lt;b&gt;RN-020&lt;/b&gt;: la bicicleta involucrada pasa al estado de mantenimiento visible solo para el administrador.&lt;br&gt;4. &lt;b&gt;RF reserva&lt;/b&gt;: un usuario con reportes activos no puede reservar (el reporte activo es Registrado o En revisión).&lt;br&gt;5. &lt;b&gt;RU-08 / RU-16&lt;/b&gt;: el usuario reporta durante el uso (o cuando pueda); el administrador gestiona reportes y sanciones.&lt;br&gt;6. &lt;b&gt;RN-09 / RN-013&lt;/b&gt;: los cambios del reporte y de sus evidencias se registran de forma inmutable en la auditoría.&lt;br&gt;&lt;br&gt;&lt;b&gt;Supuestos a validar&lt;/b&gt;&lt;br&gt;• &quot;Descartado&quot; (reporte improcedente) no está en los documentos; se propone para cerrar reportes sin acción.&lt;br&gt;• Resolver implica una acción registrada: reparación, baja o redistribución (RF gestión de reportes)." vertex="1">
          <mxGeometry height="427" width="420" x="20" y="76" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
