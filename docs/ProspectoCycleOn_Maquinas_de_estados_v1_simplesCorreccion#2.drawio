  <diagram id="pg9" name="M2 · Sanción">
    <mxGraphModel dx="2132" dy="1055" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#1F3864;spacing=2;" value="&lt;b&gt;M2 · Máquina de estados — Sanción&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1560" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5F6B7A;spacing=2;" value="Máquina de estados UML · Fase 1 (estados simples) · negocio de renta de bicicletas CycleOn" vertex="1">
          <mxGeometry height="20" width="1560" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F8FE;strokeColor=#B5D4F4;strokeWidth=1;fontSize=11;fontColor=#1F2A44;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Entidad modelada&lt;/b&gt;&lt;br&gt;Sanción aplicada a un usuario (UML: Sancion con TipoDePenalizacion, Estado, motivo, fecha y hora).&lt;br&gt;&lt;br&gt;&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;Activa → Cumplida | Revocada. La sanción económica se cumple al pagarse; el bloqueo temporal al vencer 1 mes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas que gobiernan su comportamiento&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;RN-06&lt;/b&gt;: si el usuario no devuelve la bicicleta antes del tiempo final recibe una sanción económica.&lt;br&gt;2. &lt;b&gt;RN-07&lt;/b&gt;: daño, modificación indebida o hurto → bloqueo temporal de 1 mes; reincidencia en 11 meses → bloqueo permanente.&lt;br&gt;3. &lt;b&gt;RN-08&lt;/b&gt;: la sanción se marca con fecha, hora, descripción, estado e id del usuario a penalizar.&lt;br&gt;4. &lt;b&gt;RN-010&lt;/b&gt;: las sanciones económicas se suman al valor del pago del préstamo.&lt;br&gt;5. &lt;b&gt;RF sanciones&lt;/b&gt;: el administrador registra y gestiona sanciones (motivo, fecha, duración si aplica, estado); el usuario consulta su histórico.&lt;br&gt;6. &lt;b&gt;RN-09 / RN-013&lt;/b&gt;: cada cambio de estado de la sanción se audita de forma inmutable.&lt;br&gt;&lt;br&gt;&lt;b&gt;Supuestos a validar&lt;/b&gt;&lt;br&gt;• El bloqueo permanente no vence: solo sale de Activa con revocarSanción().&lt;br&gt;• El pago de la sanción económica llega como evento pagoConfirmado() desde la máquina Pago (M7)." vertex="1">
          <mxGeometry height="458" width="420" x="20" y="76" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="ellipse;html=1;fillColor=#1F3864;strokeColor=#1F3864;aspect=fixed;" value="" vertex="1">
