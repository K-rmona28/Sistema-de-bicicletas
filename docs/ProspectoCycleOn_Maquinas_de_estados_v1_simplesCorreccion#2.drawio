          <mxGeometry height="74" width="240" x="915" y="280" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="n8" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / aplicarSanciónEconómica()&lt;br&gt;&lt;b&gt;do&lt;/b&gt; / notificarVencimiento()" vertex="1">
          <mxGeometry height="44" width="240" y="30" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="swimlane;fontStyle=1;fontSize=13;rounded=1;arcSize=7;startSize=30;html=1;whiteSpace=wrap;fillColor=#DADADA;swimlaneFillColor=#F7F7F7;strokeColor=#1F3864;strokeWidth=1.5;fontColor=#1F3864;collapsible=0;" value="Cancelado" vertex="1">
