          <mxGeometry height="129" width="240" x="490" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="n6" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / registrarVigencia(inicio, fin)&lt;br&gt;&lt;b&gt;do&lt;/b&gt; / esperarInicio()&lt;hr size=&quot;1&quot; style=&quot;margin:2px 0&quot;&gt;↻ modificarTarifa() [permiso de tarifas] / actualizarValorHora()" vertex="1">
          <mxGeometry height="99" width="240" y="30" as="geometry" />
