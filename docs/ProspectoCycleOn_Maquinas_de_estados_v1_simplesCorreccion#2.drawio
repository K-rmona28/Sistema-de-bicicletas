          <mxGeometry height="59" width="240" x="1340" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="n10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;fontSize=11;fontColor=#1F2A44;" value="&lt;b&gt;entry&lt;/b&gt; / conservarHistorial()" vertex="1">
